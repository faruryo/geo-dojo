{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>faruryo/renovate-config"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 6:00am on Monday"
  ],
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Keep core framework packages separate and require manual review",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "drizzle-orm",
        "@supabase/supabase-js",
        "@supabase/ssr"
      ],
      "groupName": "core framework",
      "automerge": false
    }
  ]
}
